# Copie este arquivo para backend/.env e preencha.
# O servidor já roda restrito a 127.0.0.1.

# Segredo usado para criptografar as chaves de API salvas em config.json.
BACKEND_SECRET=troque-por-um-valor-longo-e-aleatorio

# Token de autenticação (OBRIGATÓRIO no modo standalone). Toda requisição /api
# exige o header "Authorization: Bearer <token>" e toda mensagem WebSocket exige
# o campo "token". Se não for definido, o servidor gera um token aleatório e o
# imprime no console ao iniciar.
BACKEND_TOKEN=

# Pasta padrão do projeto (opcional).
# PROJECT_ROOT=C:\caminho\para\projeto
