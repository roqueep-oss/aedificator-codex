# ===== TOKENS PARA PUBLICAÇÃO =====
# Copie este arquivo para ".env.local" e preencha os valores.
# NUNCA commite o .env.local (já está no .gitignore).

# Token do GitHub (GitHub > Settings > Developer settings > Personal access tokens)
# Escopo: repo (clássico) ou "Contents: write" + "Releases" (fine-grained)
GITHUB_TOKEN=

# Token do GitLab (GitLab > User Settings > Access Tokens)
# Escopo: "api" (cria releases) e/ou "write_repository"
GITLAB_TOKEN=