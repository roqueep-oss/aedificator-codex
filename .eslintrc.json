{
  "root": true,
  "env": {
    "node": true,
    "browser": true,
    "es2021": true
  },
  "globals": {
    "monaco": "readonly",
    "marked": "readonly"
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "extends": "eslint:recommended",
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "no-console": "off",
    "no-constant-condition": ["error", { "checkLoops": false }],
    "no-empty": ["error", { "allowEmptyCatch": true }],
    "no-func-assign": "off"
  },
  "ignorePatterns": [
    "node_modules/",
    "dist/",
    "build/",
    ".aedificator-codex-ide-backup/",
    "frontend/vendor/",
    "*.min.js"
  ]
}
