{
  "root": true,
  "env": {
    "node": true,
    "browser": true,
    "es2021": true
  },
  "globals": {
    "monaco": "readonly",
    "marked": "readonly"
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "extends": "eslint:recommended",
  "rules": {
    "no-unused-vars": ["warn", { "args": "none", "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "no-console": "off",
    "no-constant-condition": ["error", { "checkLoops": false }],
    "no-empty": ["error", { "allowEmptyCatch": true }],
    "no-func-assign": "off"
  },
  "ignorePatterns": [
    "node_modules/",
    "dist/",
    "build/",
    ".aedificator-codex-ide-backup/",
    "frontend/vendor/",
    "*.min.js"
  ],
  "overrides": [
    {
      "files": ["frontend/script.js", "frontend/multi-agent.js"],
      "env": { "node": false },
      "globals": {
        "require": "readonly",
        "define": "readonly"
      }
    }
  ]
}
